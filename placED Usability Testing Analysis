<title>placED Usability Testing</title>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Public+Sans:wght@400;500;600;700;800&family=IBM+Plex+Mono:wght@400;500&display=swap">
<style>
  :root{
    --paper:#FCFCFD; --card:#FFFFFF; --ink:#12182A; --grey:#6B7488; --line:#E6E9F0;
    --blue:#1B6DF0; --blue-soft:#EDF3FE; --warm:#C25A00; --warm-soft:#FFF3E6;
    --good:#0E7A4E; --good-soft:#E6F5EE; --hi:#B3261E; --hi-soft:#FDECEA;
    --chip-bg:#1B6DF0; --chip-fg:#FFFFFF; --blue-hover:#DCE8FD;
  }
  @media (prefers-color-scheme: dark){
    :root:not([data-theme="light"]){
      --paper:#0D111C; --card:#151B29; --ink:#EEF1F7; --grey:#98A1B3; --line:#242C3D;
      --blue:#6FA5FF; --blue-soft:#16233C; --warm:#FFA351; --warm-soft:#2C1F13;
      --good:#5FD3A0; --good-soft:#132A21; --hi:#FF8A80; --hi-soft:#2E1715;
      --chip-bg:#6FA5FF; --chip-fg:#0D111C; --blue-hover:#1E2E4C;
    }
  }
  :root[data-theme="dark"]{
    --paper:#0D111C; --card:#151B29; --ink:#EEF1F7; --grey:#98A1B3; --line:#242C3D;
    --blue:#6FA5FF; --blue-soft:#16233C; --warm:#FFA351; --warm-soft:#2C1F13;
    --good:#5FD3A0; --good-soft:#132A21; --hi:#FF8A80; --hi-soft:#2E1715;
    --chip-bg:#6FA5FF; --chip-fg:#0D111C; --blue-hover:#1E2E4C;
  }
  *{box-sizing:border-box}
  body{margin:0;background:var(--paper);color:var(--ink);
    font-family:"Public Sans",-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;
    font-size:16px;line-height:1.6;-webkit-font-smoothing:antialiased}
  .wrap{max-width:780px;margin:0 auto;padding:60px 24px 100px;
    display:flex;flex-direction:column;gap:46px}
  h1{font-weight:800;font-size:clamp(36px,6vw,50px);line-height:1.02;margin:0;
    letter-spacing:-1.2px}
  h2{font-weight:700;font-size:22px;line-height:1.25;margin:0;letter-spacing:-.3px}
  h3{font-size:17px;font-weight:700;margin:0}
  p{margin:0 0 12px}
  p:last-child{margin-bottom:0}
  .kicker{font-family:"IBM Plex Mono",monospace;font-size:11.5px;letter-spacing:1.6px;
    text-transform:uppercase;color:var(--grey);margin:14px 0 0}
  .sub{font-size:20px;font-weight:600;color:var(--blue);margin:8px 0 0}
  section{display:flex;flex-direction:column}
  .sh{display:flex;align-items:center;gap:12px;margin-bottom:16px}
  .sh .tile{width:34px;height:34px;border-radius:10px;background:var(--blue-soft);
    display:flex;align-items:center;justify-content:center;flex:0 0 auto}
  .sh .tile svg{width:18px;height:18px;stroke:var(--blue);fill:none;
    stroke-width:1.9;stroke-linecap:round;stroke-linejoin:round}
  .stats{display:grid;gap:10px;grid-template-columns:repeat(2,1fr);margin-top:24px}
  @media(min-width:620px){.stats{grid-template-columns:repeat(4,1fr)}}
  .st{background:var(--card);border:1px solid var(--line);border-radius:12px;padding:14px 16px}
  .st b{display:block;font-size:26px;font-weight:800;letter-spacing:-.8px;line-height:1}
  .st span{font-size:12.5px;color:var(--grey);display:block;margin-top:5px}
  .who{background:var(--card);border:1px solid var(--line);border-radius:14px;
    display:flex;flex-direction:column}
  .who .r{display:flex;gap:14px;padding:17px 19px;align-items:flex-start}
  .who .r + .r{border-top:1px solid var(--line)}
  .who .ic{width:36px;height:36px;border-radius:10px;flex:0 0 auto;
    display:flex;align-items:center;justify-content:center;background:var(--blue-soft)}
  .who .ic svg{width:19px;height:19px;stroke:var(--blue);fill:none;
    stroke-width:1.9;stroke-linecap:round;stroke-linejoin:round}
  .who h4{margin:0 0 3px;font-size:15.5px;font-weight:700}
  .who p{margin:0;font-size:14.5px;color:var(--grey)}
  .tico{width:32px;height:32px;border-radius:9px;background:var(--blue-soft);
    display:flex;align-items:center;justify-content:center;flex:0 0 auto}
  .tico svg{width:17px;height:17px;stroke:var(--blue);fill:none;
    stroke-width:1.9;stroke-linecap:round;stroke-linejoin:round}
  .thead{display:flex;align-items:center;gap:12px}
  .o .l{display:flex;align-items:center;gap:6px}
  .o .l svg{width:13px;height:13px;fill:none;stroke:currentColor;
    stroke-width:2.1;stroke-linecap:round;stroke-linejoin:round}

  .anchors{position:sticky;top:0;z-index:20;background:var(--paper);
    padding:14px 0 12px;margin:0 0 -14px;border-bottom:1px solid var(--line)}
  .abar{display:flex;gap:8px;overflow-x:auto;padding:2px;scrollbar-width:none}
  .abar::-webkit-scrollbar{display:none}
  .abar a{flex:0 0 auto;display:inline-flex;align-items:center;gap:9px;
    padding:11px 16px;border-radius:11px;text-decoration:none;
    background:var(--blue-soft);color:var(--blue);font-size:14px;font-weight:600;
    white-space:nowrap;transition:background .18s ease,color .18s ease}
  .abar a svg{width:19px;height:19px;fill:none;stroke:currentColor;stroke-width:1.9;
    stroke-linecap:round;stroke-linejoin:round;flex:0 0 auto}
  .abar a:hover{background:var(--blue-hover)}
  .abar a.on{background:var(--chip-bg);color:var(--chip-fg)}
  .abar a:focus-visible{outline:2px solid var(--ink);outline-offset:3px}
  @media (prefers-reduced-motion:reduce){.abar a{transition:none}}

  .ttabs{display:flex;gap:5px;overflow-x:auto;background:var(--card);
    border:1px solid var(--line);border-radius:14px;padding:6px;margin-bottom:16px;
    scrollbar-width:none}
  .ttabs::-webkit-scrollbar{display:none}
  .ttab{flex:1 0 auto;display:flex;flex-direction:column;align-items:center;gap:5px;
    padding:10px 14px;border-radius:10px;border:0;background:transparent;cursor:pointer;
    font-family:inherit;font-size:12.5px;font-weight:600;color:var(--grey)}
  .ttab svg{width:19px;height:19px;fill:none;stroke:currentColor;stroke-width:1.8;
    stroke-linecap:round;stroke-linejoin:round}
  .ttab:hover{color:var(--ink)}
  .ttab:focus-visible{outline:2px solid var(--blue);outline-offset:2px}
  .ttab.on{background:var(--blue-soft);color:var(--blue)}
  ul{margin:0;padding:0;list-style:none;display:flex;flex-direction:column;gap:9px}
  ul li{padding-left:20px;position:relative;color:var(--ink)}
  ul li::before{content:"";position:absolute;left:4px;top:11px;width:5px;height:5px;
    border-radius:50%;background:var(--blue)}

  .scroll{overflow-x:auto}
  table{border-collapse:collapse;width:100%;min-width:520px;font-size:15px}
  th,td{text-align:left;padding:12px 14px;border-bottom:1px solid var(--line);vertical-align:top}
  th{font-family:"IBM Plex Mono",monospace;font-size:10.5px;letter-spacing:1px;
    text-transform:uppercase;color:var(--grey);font-weight:500}
  tr:last-child td{border-bottom:none}
  td:first-child{font-weight:600;width:38%}

  .task{background:var(--card);border:1px solid var(--line);border-radius:16px;
    padding:24px 26px;display:none;flex-direction:column;gap:16px}
  .task.show{display:flex}
  .tnum{font-family:"IBM Plex Mono",monospace;font-size:11px;letter-spacing:1.4px;
    text-transform:uppercase;color:var(--blue)}
  .quote{background:var(--blue-soft);border-radius:10px;padding:13px 16px;
    font-size:16px;color:var(--ink)}
  .meta{display:flex;flex-direction:column;gap:10px}
  .mrow{display:grid;grid-template-columns:150px 1fr;gap:14px;align-items:baseline;
    font-size:14.5px}
  @media(max-width:560px){.mrow{grid-template-columns:1fr;gap:3px}}
  .mrow .k{font-family:"IBM Plex Mono",monospace;font-size:10.5px;letter-spacing:.9px;
    text-transform:uppercase;color:var(--grey)}
  .flow{display:flex;flex-wrap:wrap;gap:5px;align-items:center}
  .chip{background:var(--blue-soft);color:var(--blue);border-radius:6px;
    padding:4px 9px;font-size:12.5px;font-weight:600;white-space:nowrap}
  .arw{color:var(--grey);font-size:11px}
  .obs .h{font-family:"IBM Plex Mono",monospace;font-size:10.5px;letter-spacing:.9px;
    text-transform:uppercase;color:var(--grey);margin-bottom:9px}
  .out{display:flex;flex-direction:column;gap:10px}
  .o{border-radius:10px;padding:13px 16px;font-size:14.5px;display:flex;
    flex-direction:column;gap:3px}
  .o .l{font-family:"IBM Plex Mono",monospace;font-size:10px;letter-spacing:1px;
    text-transform:uppercase;opacity:.85}
  .o.fr{background:var(--warm-soft);color:var(--warm)}
  .o.ki{background:var(--card);border:1px solid var(--line);color:var(--ink)}
  .o.dc{background:var(--good-soft);color:var(--good)}
  .o strong{font-weight:600}

  .note{font-size:14.5px;color:var(--grey);border-left:2px solid var(--line);
    padding-left:16px}
  footer{border-top:1px solid var(--line);padding-top:20px;color:var(--grey);font-size:13.5px}
</style>

